# ===== Database =====
# Docker 模式用 postgres，本地开发用 localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=health_steward
POSTGRES_USER=health
POSTGRES_PASSWORD=changeme

# ===== Model Provider: Multimodal API (Required) =====
MULTIMODAL_API_BASE=https://api.openai.com/v1
MULTIMODAL_API_KEY=sk-your-key-here
MULTIMODAL_API_MODEL=gpt-4o

# ===== Model Provider: Text API (Optional) =====
TEXT_API_BASE=https://api.openai.com/v1
TEXT_API_KEY=sk-your-key-here
TEXT_API_MODEL=gpt-4o-mini

# ===== Model Provider: Local LLM (Optional) =====
LOCAL_LLM_BASE=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3

# ===== Text Provider Priority (text_api | local_llm) =====
TEXT_PROVIDER_PRIORITY=text_api

# ===== Feishu Bot (Optional, V0.4) =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ===== App =====
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173

# ===== Security (P0-3) =====
# 访问令牌：留空 = 本地开放模式（默认）；非空 = 所有业务 API 需
# Authorization: Bearer <AUTH_TOKEN>。局域网/多设备访问建议开启。
AUTH_TOKEN=
# /chat 与 /chat/stream 每成员每分钟最大请求数，防误触发/刷接口烧 LLM 费用。
CHAT_RATE_LIMIT_PER_MIN=20

# Embedding model (for RAG report knowledge base)
# If left empty, defaults to TEXT_API_BASE / TEXT_API_KEY
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
