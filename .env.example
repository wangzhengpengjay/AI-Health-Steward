# ===== Database =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=health_steward
POSTGRES_USER=health
POSTGRES_PASSWORD=changeme

# ===== Model Provider: Multimodal API (Required) =====
MULTIMODAL_API_BASE=https://api.openai.com/v1
MULTIMODAL_API_KEY=sk-your-key-here
MULTIMODAL_API_MODEL=gpt-4o

# ===== Model Provider: Text API (Optional) =====
TEXT_API_BASE=https://api.openai.com/v1
TEXT_API_KEY=sk-your-key-here
TEXT_API_MODEL=gpt-4o-mini

# ===== Model Provider: Local LLM (Optional) =====
LOCAL_LLM_BASE=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3

# ===== Text Provider Priority (text_api | local_llm) =====
TEXT_PROVIDER_PRIORITY=text_api

# ===== Feishu Bot (Optional, V0.4) =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ===== App =====
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173
